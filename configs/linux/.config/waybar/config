{
    "layer": "top",
    "spacing": 0,
    "height": 0,

    "margin-top": 0,
    "margin-right": 0,
    "margin-bottom": 0,
    "margin-left": 0,

    "modules-left": [
        "sway/workspaces",
        "sway/mode",
        "custom/split-mode"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "tray",
        "custom/mouse-battery",
        "network",
        "battery",
        "memory",
        "cpu",
        "pulseaudio"
    ],

    "sway/mode": {
        "tooltip": false
    },

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "tooltip": false
    },

    "custom/split-mode": {
        "exec": "~/.config/waybar/scripts/split_mode.sh",
        "exec-on-event": false,
        "tooltip": false
    },

    "tray": {
        "spacing": 10,
        "tooltip": false
    },

    "clock": {
        "format": "{:%a %d, %I:%M %p}",
        "tooltip": false
    },

    "custom/mouse-battery": {
        "exec": "~/.config/waybar/scripts/mouse_battery.sh",
        "interval": 60,
        "format": "󰍽 {}",
        "tooltip": false
    },

    "network": {
        "format-wifi": "󰤨 {essid} {signalStrength}%",
        "format-ethernet": "󰈀 {ifname}",
        "format-disconnected": "󰤭 offline",
        "interval": 10,
        "tooltip": false
    },

    "battery": {
        "format": "󰁹 {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-full": "󰁹 full",
        "format-plugged": "󰚥 {capacity}%",
        "interval": 30,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "tooltip": false
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 2,
        "on-click": "kitty htop",
        "states": {
            "critical": 90
        },
        "tooltip": false
    },

    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 2,
        "states": {
            "critical": 80
        },
        "tooltip": false
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "scroll-step": 5,
        "tooltip": false
    }
}
